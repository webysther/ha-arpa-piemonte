{
    "title": "Arpa Piemonte",
    "config": {
        "step": {
            "user": {
                "title": "Add a station",
                "description": "The readings of the stations of Arpa Piemonte: river level, rain, temperature, humidity, wind and snow, as each station measures them, and the natural risks of their municipality. Not an official app of Arpa Piemonte.",
                "data": {
                    "municipality": "Municipality"
                },
                "data_description": {
                    "municipality": "Type to search among the municipalities of Piedmont with a station. Its stations are grouped under it."
                }
            },
            "station": {
                "title": "Stations of {municipality}",
                "description": "The rivers first, then the weather stations.",
                "data": {
                    "station_code": "Station"
                },
                "data_description": {
                    "station_code": "The point of the river that matters to you, not necessarily the nearest one."
                }
            },
            "reconfigure": {
                "title": "Read {municipality} again",
                "description": "Read the sensors, thresholds and identifiers of every station of {municipality} again from Arpa Piemonte."
            }
        },
        "error": {
            "cannot_connect": "Arpa Piemonte cannot be reached. Try again later.",
            "municipality_not_listed": "No station of Arpa Piemonte in this municipality. Choose one from the list."
        },
        "abort": {
            "already_configured": "Every station of this municipality is already added.",
