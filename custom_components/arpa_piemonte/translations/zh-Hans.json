                    "municipality": "市镇"
                },
                "data_description": {
                    "municipality": "输入名称，在皮埃蒙特设有站点的市镇中搜索。该市镇的站点将归入其下。"
                }
            },
            "station": {
                "title": "{municipality} 的站点",
